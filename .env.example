# Application Environment Variables Template
NODE_ENV=development

# Web Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Backend API (apps/api)
PORT=4000
DATABASE_URL="postgresql://cafex_user:cafex_dev_pass@localhost:5432/cafex_db?schema=public"
JWT_SECRET="cafex_development_jwt_secret_min_32_chars_long_key_change_in_prod"
JWT_EXPIRES_IN="7d"

# Payment Gateway Sandbox (Backend)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Business Default Settings
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL="₹"
DEFAULT_TIMEZONE="Asia/Kolkata"
